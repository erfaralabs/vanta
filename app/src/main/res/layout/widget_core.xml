<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_core_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Triple Ring Graphic canvas bitmap -->
    <ImageView
        android:id="@+id/widget_core_rings_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview_core"
        android:contentDescription="VANTA Core Triple Rings" />

    <!-- Step Count Readout -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_core_steps_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:singleLine="true"
            android:text="8,420 STEPS"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Unique Physiological Intelligence / Target Status Line -->
    <TextView
        android:id="@+id/widget_core_status_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:singleLine="true"
        android:text="HIGH RECOVERY"
        android:textColor="#00F5FF"
        android:textSize="9.5sp"
        android:textStyle="bold" />

</LinearLayout>

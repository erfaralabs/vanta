<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_daily_summary_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp">

    <!-- Column 1: Strain -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_strain_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="3.4"
            android:textColor="#00F5FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:singleLine="true"
            android:text="STRAIN"
            android:textColor="#9CA3AF"
            android:textSize="8.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:background="#26FFFFFF" />

    <!-- Column 2: Recovery -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_recovery_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="57%"
            android:textColor="#39FF80"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:singleLine="true"
            android:text="RECOVERY"
            android:textColor="#9CA3AF"
            android:textSize="8.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:background="#26FFFFFF" />

    <!-- Column 3: Energy -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_energy_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="75"
            android:textColor="#0080FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:singleLine="true"
            android:text="ENERGY"
            android:textColor="#9CA3AF"
            android:textSize="8.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
